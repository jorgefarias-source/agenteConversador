APP_MODE=pilot
LLM_PROVIDER=mock
ALLOW_PAID_LLM=false
ALLOW_WHATSAPP_SEND=false
LLM_MODEL=
OPENAI_API_KEY=
LLM_BUDGET_USD=0
PORT=3002
# Token exclusivamente administrativo. Integrações clientes usam credenciais próprias,
# vinculadas a tenant e emitidas pela API administrativa.
AGENT_CONNECTOR_TOKEN=trocar_por_token_administrativo
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Banco descartável e isolado, usado exclusivamente por npm run test:db.
TEST_DATABASE_URL=
AGENT_RETENTION_DAYS=90
# Mapeamento canal -> tenant vive nas tabelas tenants/tenant_channels
# (ver migrations/0001_init.sql). Use "npm run seed:demo" para popular o tenant demo.
# Restrição de coorte (PILOT_SENDERS) agora é por tenant, no banco (migrations/0004),
# gerenciada via POST/GET/DELETE /v1/tenants/:channel_account_id/pilot-senders
# e /v1/tenants/:channel_account_id/pilot-mode. Por padrão um tenant novo atende
# qualquer remetente (pilot_mode=false).
# WHATSAPP_CHANNEL_ACCOUNT_ID não é mais necessário: conexões são multi-tenant e
# iniciadas via POST /v1/whatsapp/connections; sessões salvas retomam sozinhas no boot.
